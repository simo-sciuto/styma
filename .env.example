# Chiave API Anthropic. Serve per identificazione e ricerca di mercato.
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase. Senza queste due variabili l'analisi funziona lo stesso,
# ma l'inventario resta disabilitato.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sviluppo senza spendere. Con STYMA_AI_FIXTURES=1 l'app rigioca le risposte
# registrate in bench/fixtures invece di chiamare il modello: nessun costo.
# Con STYMA_AI_RECORD=1 chiama il modello davvero e salva cio' che torna,
# cosi' si paga una volta sola per una prova che poi si ripete gratis.
# Entrambe rifiutano di partire con NODE_ENV=production.
STYMA_AI_FIXTURES=
STYMA_AI_RECORD=

# Chiave di servizio Supabase, SOLO lato server. Serve alla cache delle ricerche
# di mercato, che e' una tabella senza policy: nessun client la raggiunge.
# Senza questa variabile la cache si spegne da sola e ogni analisi paga la
# propria ricerca. Non usare mai il prefisso NEXT_PUBLIC_: finirebbe nel browser.
SUPABASE_SERVICE_ROLE_KEY=

# eBay Browse API: prezzi strutturati senza far navigare il modello.
# Senza queste variabili l'analisi funziona lo stesso, ricadendo sulla ricerca
# col modello, che costa molto di piu'. EBAY_ENV accetta `sandbox` o
# `production`: il sandbox si autentica ma non contiene inserzioni reali.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=sandbox

# Discogs: catalogo musicale e situazione di mercato di un'edizione.
# Facoltativo. Senza token l'API risponde lo stesso: il token alza solo il
# limite di richieste, non sblocca dati diversi. Lo storico delle vendite
# NON e' accessibile in nessun caso senza OAuth con account venditore.
DISCOGS_TOKEN=
